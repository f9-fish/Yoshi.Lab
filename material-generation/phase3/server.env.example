# Default OFF. These are server settings, never sheet cells or browser settings.
MG_ENABLED=false
MG_MODE=TEST
MG_TEST_APPEND_ENABLED=false
MG_AUTH_VERIFIED=false
MG_STORAGE_VERIFIED=false
MG_TEST_SPREADSHEET_ID=
MG_GOOGLE_AUDIENCE=
MG_STATE_DIR=
MG_GEMINI_MODEL=
# Set MG_GEMINI_API_KEY with the hosting server's secret manager, not in this file.
MG_DAILY_LIMIT=10
# An HTTPS reverse proxy is required for Apps Script. Default binding is local only.
MG_BIND_HOST=127.0.0.1
PORT=8080
